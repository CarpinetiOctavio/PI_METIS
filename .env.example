# JWT
#
# JWT_SECRET_KEY debe ser un string largo y aleatorio. Nunca dejar vacío en
# ningún entorno — un JWT firmado con string vacío es técnicamente funcional
# pero sin ninguna seguridad. Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=reemplazar-con-string-aleatorio-largo
JWT_EXPIRE_MINUTES=60

# Base de datos
#
# REGLA: las credenciales de DATABASE_URL deben coincidir exactamente con
# POSTGRES_USER y POSTGRES_PASSWORD definidos más abajo.
# Si no coinciden, el backend arranca pero falla en el primer query.
#
# IMPORTANTE — DATABASE_URL tiene dos formas según el contexto de ejecución:
#
#   Dentro de Docker (backend en runtime):
#     host = "postgres"  ← nombre del servicio en la red Docker interna
#     DATABASE_URL=postgresql+asyncpg://metis_user:metis_pass@postgres:5432/metis
#
#   Desde el host (Alembic, psql, tests de integración fuera de Docker):
#     host = "localhost" ← puerto 5432 mapeado al host via docker-compose ports
#     Sobreescribir en la línea de comando (nunca en el .env):
#     DATABASE_URL=postgresql+asyncpg://metis_user:metis_pass@localhost:5432/metis alembic upgrade head
#
#   El .env siempre debe tener "postgres" como host. El override de localhost
#   solo se usa en la terminal, nunca se commitea.
DATABASE_URL=postgresql+asyncpg://metis_user:metis_pass@postgres:5432/metis
POSTGRES_USER=metis_user
POSTGRES_PASSWORD=metis_pass
POSTGRES_DB=metis

# Frontend (CORS y redirección post-login)
#
# FRONTEND_ORIGIN controla la política CORS del backend — debe coincidir con
# el origen exacto desde donde el frontend hace requests (protocolo + dominio + puerto).
# FRONTEND_URL se usa para construir links en mails (ej. link de verificación).
# Ambas variables son requeridas — si falta FRONTEND_ORIGIN, el backend rechaza
# todas las requests del frontend con error CORS.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Entorno (development | production) — controla Secure en la cookie JWT
# En development: Secure=False (permite HTTP en localhost)
# En production: Secure=True (solo HTTPS)
ENV=development

# SMTP — pendiente de credenciales de IT (ver decisions-log.md — DECISIÓN 004)
# Cuando IT provea la cuenta metis-noreply@ucc.edu.ar y el App Password de 16 dígitos,
# descomentar estas variables y reemplazar send_verification_email en auth/email.py.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=metis-noreply@ucc.edu.ar
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx